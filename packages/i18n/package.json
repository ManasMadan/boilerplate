{
  "name": "@repo/i18n",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Every user-facing string, for every surface: web, mobile, emails, push, SMS and in-app notifications.",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./messages/*.json": "./messages/*.json"
  },
  "scripts": {
    "check-types": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
