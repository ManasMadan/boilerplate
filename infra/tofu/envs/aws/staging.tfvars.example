# Copy to staging.tfvars (kept out of git: it may hold provider keys).
environment           = "staging"
region                = "eu-west-1"
domain                = "example.com"
site_host             = "staging.example.com"
cloudflare_account_id = "0123456789abcdef0123456789abcdef"
tls_email             = "ops@example.com"
state_kms_key_id      = "arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000"
previews              = true
# github_token = set with TF_VAR_github_token
# service_secrets = { api = { STRIPE_SECRET_KEY = "sk_test_…" }, notifications = { RESEND_API_KEY = "…" } }
