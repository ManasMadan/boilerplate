{
  "name": "@repo/notifications",
  "private": true,
  "type": "module",
  "description": "Notification service: consumes the `notifications` queue and delivers over every channel.",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs\"",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs",
    "check-types": "tsc",
    "test": "vitest run src --passWithNoTests",
    "test:integration": "bun --env-file=../../.env run vitest run test"
  },
  "dependencies": {
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/nest-common": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "nodemailer": "^10.0.12",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@repo/tsdown-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
