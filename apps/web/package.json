{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "description": "The web app: renders UI only. All data and logic come from apps/api through packages/client.",
  "scripts": {
    "dev": "bun --env-file=../../.env run next dev --port 3000",
    "build": "bun --env-file=../../.env run next build && bun run scripts/copy-static.ts",
    "start": "node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "check-types": "SKIP_ENV_VALIDATION=1 next typegen && tsc",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@repo/client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/ui": "workspace:*",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "geist": "^1.7.2",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "^4.14.7",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.89.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "ioredis": "catalog:",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
