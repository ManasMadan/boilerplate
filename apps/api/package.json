{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "description": "The HTTP API: authentication (better-auth) and the oRPC API defined in packages/contracts.",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs\"",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.mjs",
    "check-types": "tsc",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "bun --env-file=../../.env run vitest run --project integration",
    "auth:schema": "bun --env-file=../../.env run auth generate --config src/auth/auth.cli.ts --adapter prisma --dialect postgresql --output ../../node_modules/.cache/auth-schema.prisma --yes"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@better-auth/redis-storage": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/ai-client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/jobs": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/nest-common": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "^5.2.1",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@orpc/client": "catalog:",
    "@repo/fake-stripe": "workspace:*",
    "@repo/tsdown-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
