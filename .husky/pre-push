# Types and unit tests for the packages this branch changes, and the repo's scripts and
# Claude Code hooks, before anything leaves the machine. CI still runs everything.
bunx turbo run check-types test --affected --output-logs=errors-only
bunx tsc -p scripts
bunx tsc -p .claude/hooks
bunx tsc -p turbo/generators
# --no-env-file: the tests get the test environment, as in CI, not this checkout's .env
# (Bun loads it into `bun <file>` and `bun test`, and every suite they start inherits it).
bun --no-env-file test ./scripts/ ./.claude/hooks/
# Every line the branch changes in a unit-tested file is covered by its unit tests (CI's
# diff-cover checks the rest against every suite merged).
bun --no-env-file scripts/unit-coverage.ts --branch
# Unused files, exports and dependencies (knip): quick, and CI fails on them.
bun run lint:unused
