# Copy to .env (`bun run setup` does it for you). Every app reads this one file.
# Variables are validated at startup/build time; see apps/api/src/env.ts and apps/web/src/env.ts.

# ---- Local service ports (docker-compose.yml) ----
# Change one if something on your machine already uses it, and update the matching URL.
POSTGRES_PORT=5432
VALKEY_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=9000
S3_CONSOLE_PORT=9001
STRIPE_MOCK_PORT=12111

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# ---- Redis / Valkey (sessions, cache, rate limits, queues) ----
REDIS_URL=redis://localhost:6379

# ---- Email (apps/notifications) ----
# smtp sends to Mailpit locally (open http://localhost:8025 to read every email).
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Boilerplate <no-reply@example.com>
# For Resend in production: EMAIL_PROVIDER=resend and RESEND_API_KEY=re_...
RESEND_API_KEY=

# ---- API (apps/api) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the API server. better-auth builds callback and reset links from it.
BETTER_AUTH_URL=http://localhost:3001
# Public URL of the web app. Used for CORS and as the only trusted auth origin.
WEB_URL=http://localhost:3000
# URL of the Python AI service (apps/ai).
AI_URL=http://localhost:8000

# Optional: enable "Sign in with Google" by setting both.
# Redirect URI to register in Google Cloud: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Web (apps/web) ----
# Inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
