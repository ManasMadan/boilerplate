{
  "name": "boilerplate",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "load"
    ],
    "catalog": {
      "@better-auth/api-key": "^1.7.6",
      "@better-auth/cimd": "^1.7.6",
      "@better-auth/expo": "^1.7.6",
      "@better-auth/mcp": "^1.7.6",
      "@better-auth/oauth-provider": "^1.7.6",
      "@better-auth/passkey": "^1.7.6",
      "@better-auth/redis-storage": "^1.7.6",
      "@modelcontextprotocol/sdk": "^1.31.0",
      "@nestjs/bullmq": "^12.0.0",
      "@nestjs/common": "^12.1.1",
      "@nestjs/core": "^12.1.1",
      "@nestjs/platform-fastify": "^12.1.1",
      "@nestjs/testing": "^12.1.1",
      "@orpc/client": "^1.15.4",
      "@orpc/contract": "^1.15.4",
      "@orpc/openapi": "^1.15.4",
      "@orpc/openapi-client": "^1.15.4",
      "@orpc/server": "^1.15.4",
      "@orpc/tanstack-query": "^1.15.4",
      "@orpc/zod": "^1.15.4",
      "@prisma/adapter-pg": "^7.10.0",
      "@prisma/client": "^7.10.0",
      "@t3-oss/env-core": "^0.13.11",
      "@t3-oss/env-nextjs": "^0.13.11",
      "@tailwindcss/postcss": "^4.3.3",
      "@tanstack/react-query": "^5.104.0",
      "@types/k6": "^2.3.0",
      "@types/node": "^26.6.3",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "@vitest/coverage-v8": "^5.0.2",
      "better-auth": "^1.7.6",
      "bullmq": "^6.3.9",
      "fastify": "^5.12.5",
      "ioredis": "^6.0.0",
      "lucide-react": "^1.48.0",
      "next": "^16.3.6",
      "next-themes": "^0.4.6",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "prisma": "^7.10.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "stripe": "^22.6.2",
      "tailwindcss": "^4.3.3",
      "tsdown": "^0.23.0",
      "typescript": "^6.0.3",
      "use-intl": "^4.14.7",
      "vitest": "^5.0.2",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "env:set": "bun scripts/env-set.ts",
    "dev": "bun run doctor && docker compose up -d --wait && turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/notifications --filter=@repo/worker --filter=@repo/webhooks",
    "dev:full": "bun run doctor && docker compose --profile full up -d --wait && turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "biome check . && bun run lint:boundaries && turbo run lint",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:integration": "docker compose --profile full up -d --wait && turbo run test:integration",
    "test:e2e": "bun scripts/e2e.ts",
    "test:load": "bun run --cwd load test:load",
    "gen": "turbo run gen",
    "db:up": "docker compose up -d --wait",
    "db:up:full": "docker compose --profile full up -d --wait",
    "db:down": "docker compose --profile full down",
    "db:migrate": "bun run --filter @repo/db migrate",
    "db:deploy": "bun run --filter @repo/db deploy",
    "db:studio": "bun run --filter @repo/db studio",
    "db:reset": "bun run --filter @repo/db reset",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs && bun scripts/check-web-render-only.ts",
    "prepare": "husky",
    "stripe:fake": "bun run --filter @repo/fake-stripe start",
    "db:seed": "turbo run seed --filter=@repo/api",
    "test:coverage": "turbo run coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "apps/ai/**/*.py": [
      "uv run --project apps/ai ruff check --fix",
      "uv run --project apps/ai ruff format"
    ]
  }
}
